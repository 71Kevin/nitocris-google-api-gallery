# Port the server listens on
PORT=3000

# Google Images search URL used as a fallback source (optional)
SEARCH_URL=https://www.google.com/search?q=fate+grand+order+nitocris+danbooru&tbm=isch&tbs=isz:l,ic:color,itp:photo

# Image cache lifetime in milliseconds (default: 5 minutes)
CACHE_TTL_MS=300000
