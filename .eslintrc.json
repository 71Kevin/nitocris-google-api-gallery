{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:ejs/recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "plugins": ["ejs"],
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "ejs/no-multiple-outputs": "error",
    "ejs/no-async-render": "error",
    "ejs/newline-between-statement": "error"
  }
}
