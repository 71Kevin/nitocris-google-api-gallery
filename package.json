{
  "name": "nitocris-google-api-gallery",
  "version": "1.0.0",
  "description": "Multi-source image gallery for the FGO character Nitocris, with proxy, cache and custom lightbox",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "keywords": [
    "gallery",
    "image-board",
    "safebooru",
    "xbooru",
    "fate-grand-order",
    "nitocris",
    "express",
    "proxy"
  ],
  "author": "Kevin Oliveira Manhas",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.3.4",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "eslint": "^7.12.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-ejs": "^0.0.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^5.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.4.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
