<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nitocris Gallery</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <h1 class="site-title">Nitocris Gallery</h1>
        <p class="site-subtitle">Fate / Grand Order</p>
        <span class="image-count"><%= count %> image<%= count !== 1 ? 's' : '' %> found</span>
      </div>
    </header>

    <main class="container">
      <% if (images.length === 0) { %>
      <div class="empty-state">
        <p>No images found. Please try again later.</p>
        <a href="/" class="btn">Reload</a>
      </div>
      <% } else { %>
      <div class="gallery" id="gallery">
        <% images.forEach(function (image, index) { %>
        <a
          href="<%= image.full %>"
          data-lightbox="nitocris-gallery"
          data-title="Nitocris #<%= index + 1 %>"
        >
          <img
            src="<%= image.thumb %>"
            alt="Nitocris - image <%= index + 1 %>"
            loading="lazy"
          />
        </a>
        <% }); %>
      </div>
      <% } %>
    </main>

    <footer class="site-footer">
      <p>Images sourced via Danbooru &middot; Fate / Grand Order &copy; TYPE-MOON / FGO PROJECT</p>
    </footer>

    <script src="/js/gallery.js"></script>
  </body>
</html>
