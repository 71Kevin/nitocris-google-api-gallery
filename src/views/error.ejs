<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error &mdash; Nitocris Gallery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <h1 class="site-title">Nitocris Gallery</h1>
      </div>
    </header>

    <main class="container">
      <div class="error-state">
        <div class="error-icon">&otimes;</div>
        <h2>Something went wrong</h2>
        <p class="error-message"><%= message %></p>
        <a href="/" class="btn">Try again</a>
      </div>
    </main>

    <footer class="site-footer">
      <p>Fate / Grand Order &copy; TYPE-MOON / FGO PROJECT</p>
    </footer>
  </body>
</html>
